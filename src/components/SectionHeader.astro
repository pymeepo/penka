---
import Icon from './Icon.astro';

interface Props {
  title: string;
  id?: string;
  eyebrow?: string;
  link?: { href: string; label: string };
}

const { title, id, eyebrow, link } = Astro.props;
---

<div class="mb-5 flex items-end justify-between gap-4 md:mb-7">
  <div class="space-y-1.5">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id} class="text-2xl leading-tight md:text-3xl">{title}</h2>
  </div>
  {
    link && (
      <a
        href={link.href}
        class="inline-flex shrink-0 items-center gap-1 rounded-full py-2 font-semibold text-caramel-deep hover:underline"
      >
        {link.label}
        <Icon name="arrow-right" size={18} />
      </a>
    )
  }
</div>
