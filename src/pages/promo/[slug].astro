---
// Promo page — a target for push notifications: /promo/<slug>/
import type { GetStaticPaths } from 'astro';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PromoCard from '../../components/PromoCard.astro';
import { getMenuItem } from '../../data/menu';
import { promos, type Promo } from '../../data/promos';
import { formatDate } from '../../lib/format';
import { loadImage } from '../../lib/images';
import { url } from '../../lib/url';

export const getStaticPaths = (() =>
  promos.map((promo) => ({ params: { slug: promo.slug }, props: { promo } }))) satisfies GetStaticPaths;

interface Props {
  promo: Promo;
}

const { promo } = Astro.props;
const item = getMenuItem(promo.itemSlug);
if (!item) throw new Error(`Акция ${promo.slug}: нет позиции меню «${promo.itemSlug}»`);
const photo = await loadImage(promo.image);
const ogImage = await getImage({ src: photo, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const others = promos.filter((p) => p.slug !== promo.slug);
---

<BaseLayout title={promo.title} description={promo.lead} ogImage={ogImage.src} ogType="article">
  <article class="container-page pt-4 md:pt-8">
    <a href={url('promo')} class="inline-flex items-center gap-1 rounded-full py-2 pr-3 font-semibold text-muted hover:text-ink">
      <Icon name="chevron-left" />
      Все акции
    </a>

    <div class="mt-2 grid gap-6 md:grid-cols-[1.1fr_1fr] md:gap-10">
      <div class="relative">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          alt=""
          widths={[400, 640, 900, 1200]}
          sizes="(min-width: 1200px) 620px, (min-width: 768px) 52vw, 100vw"
          class="aspect-[4/3] w-full rounded-[var(--radius-card-lg)] object-cover shadow-[var(--shadow-soft)]"
          loading="eager"
          fetchpriority="high"
        />
        <span class="absolute top-4 left-4 rounded-full bg-caramel px-4 py-1.5 font-display text-lg font-bold text-ink">
          {promo.badge}
        </span>
      </div>

      <div class="space-y-5">
        <h1 class="text-3xl leading-tight md:text-4xl">{promo.title}</h1>
        <p class="text-lg">{promo.lead}</p>

        <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="inline-flex items-center gap-2 rounded-full bg-sand px-3 py-1.5 text-sm font-semibold">
            <Icon name="calendar" size={16} />
            {formatDate(promo.validFrom, false)} — {formatDate(promo.validTo)}
          </span>
          <span class="text-sm font-semibold text-sage-deep" data-days-left data-valid-to={promo.validTo} data-valid-from={promo.validFrom}
          ></span>
        </p>

        <section aria-labelledby="conditions-title" class="card p-5">
          <h2 id="conditions-title" class="mb-3 font-sans text-lg font-bold">Условия</h2>
          <ul class="space-y-2.5">
            {
              promo.conditions.map((c) => (
                <li class="flex gap-2.5">
                  <Icon name="check" size={20} class="mt-0.5 text-sage-deep" />
                  <span>{c}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <a href={url(`menu/${item.slug}`)} class="btn btn-primary w-full sm:w-auto">
          Заказать: {item.name}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="container-page pt-14 md:pt-20" aria-labelledby="others-title">
        <h2 id="others-title" class="mb-5 text-2xl md:mb-7 md:text-3xl">
          Ещё акции
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-3">
          {others.map((p) => (
            <PromoCard promo={p} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  import { plural } from '../../lib/format';

  // Status is computed in the browser, so a static page stays correct over time.
  const el = document.querySelector<HTMLElement>('[data-days-left]');
  if (el) {
    const day = 24 * 60 * 60 * 1000;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const from = new Date(`${el.dataset.validFrom}T00:00:00`);
    const to = new Date(`${el.dataset.validTo}T00:00:00`);
    if (today < from) {
      el.textContent = 'Скоро начнётся';
    } else if (today > to) {
      el.textContent = 'Акция завершилась';
      el.classList.replace('text-sage-deep', 'text-danger');
    } else {
      const left = Math.round((to.getTime() - today.getTime()) / day) + 1;
      el.textContent = left === 1 ? 'Последний день' : `Осталось ${left} ${plural(left, ['день', 'дня', 'дней'])}`;
    }
  }
</script>
