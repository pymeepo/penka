---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import Icon from '../../components/Icon.astro';
import { fullAddress, locations } from '../../data/locations';
import { url } from '../../lib/url';

// Locations are embedded so the client can show the pickup address for the stored order.
const places = Object.fromEntries(locations.map((l) => [l.slug, { name: l.name, address: fullAddress(l) }]));
---

<BaseLayout title="Заказ принят" description="Заказ в кофейне «Пенка» принят. Номер заказа и время готовности." noindex>
  <div class="container-page min-h-[55vh] max-w-xl pt-8 text-center md:pt-14" data-success data-places={JSON.stringify(places)}>
    <div class="success-badge mx-auto grid size-20 place-items-center rounded-full bg-sage text-ink">
      <Icon name="check" size={40} strokeWidth={2.5} />
    </div>
    <h1 class="mt-6 text-3xl md:text-4xl">Заказ принят</h1>
    <p class="mt-2 text-muted">Назовите номер бариста — заказ будет ждать на стойке.</p>

    <div class="card mt-8 p-6">
      <p class="text-sm font-bold tracking-wide text-muted uppercase">Номер заказа</p>
      <p class="mt-1 font-display text-6xl tracking-wider text-caramel-deep tabular-nums" data-number>—</p>
      <dl class="mt-6 grid gap-3 text-left sm:grid-cols-2">
        <div class="rounded-2xl bg-sand p-4">
          <dt class="flex items-center gap-1.5 text-sm text-muted"><Icon name="clock" size={16} /> Будет готов</dt>
          <dd class="mt-1 text-lg font-bold" data-ready>через 10–15 минут</dd>
        </div>
        <div class="rounded-2xl bg-sand p-4">
          <dt class="flex items-center gap-1.5 text-sm text-muted"><Icon name="map-pin" size={16} /> Где забрать</dt>
          <dd class="mt-1 font-bold" data-place>В выбранной кофейне</dd>
        </div>
      </dl>
      <ul class="mt-5 space-y-1.5 text-left text-sm" data-lines hidden></ul>
      <p class="mt-4 flex justify-between border-t border-ink/10 pt-3 text-lg font-extrabold" data-total-row hidden>
        <span>Итого</span><span class="tabular-nums" data-total></span>
      </p>
    </div>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
      <a href={url('account')} class="btn btn-primary">
        <Icon name="user" />
        Мои заказы в профиле
      </a>
      <a href={url('menu')} class="btn btn-ghost">Вернуться в меню</a>
    </div>
    <DemoNotice class="mt-8 text-left" />
  </div>
</BaseLayout>

<style>
  .success-badge {
    animation: pop-in 0.6s var(--ease-soft) both;
  }
  @keyframes pop-in {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }
</style>

<script>
  import { formatPrice } from '../../lib/format';
  import { formatTime, getOrder } from '../../lib/orders';

  const root = document.querySelector<HTMLElement>('[data-success]');
  if (root) {
    const n = new URLSearchParams(location.search).get('n')?.replace(/\D/g, '').slice(0, 6) ?? '';
    root.querySelector('[data-number]')!.textContent = n || '—';
    const order = n ? getOrder(n) : undefined;
    if (order) {
      const places = JSON.parse(root.dataset.places ?? '{}') as Record<string, { name: string; address: string }>;
      const place = places[order.locationSlug];
      const ready = order.asap ? `примерно к ${formatTime(order.readyAt)}` : `к ${formatTime(order.readyAt)}`;
      root.querySelector('[data-ready]')!.textContent = ready;
      if (place) root.querySelector('[data-place]')!.textContent = `${place.name}, ${place.address}`;

      const list = root.querySelector<HTMLUListElement>('[data-lines]')!;
      list.replaceChildren(
        ...order.lines.map((l) => {
          const li = document.createElement('li');
          li.className = 'flex justify-between gap-3';
          const name = document.createElement('span');
          name.textContent = `${l.name} × ${l.qty}`;
          const sum = document.createElement('span');
          sum.className = 'tabular-nums text-muted';
          sum.textContent = formatPrice(l.unitPrice * l.qty);
          li.append(name, sum);
          return li;
        }),
      );
      list.hidden = false;
      root.querySelector('[data-total]')!.textContent = formatPrice(order.total);
      root.querySelector<HTMLElement>('[data-total-row]')!.hidden = false;
    }
  }
</script>
