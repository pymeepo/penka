---
// <template> for a cart line, cloned on the client by /cart.
import Icon from './Icon.astro';
---

<template id="cart-line-template">
  <li class="cart-line card flex gap-3 p-3 sm:gap-4 sm:p-4" data-line>
    <a data-link class="shrink-0" tabindex="-1" aria-hidden="true">
      <img data-img alt="" width="80" height="80" class="size-20 rounded-2xl bg-sand object-cover sm:size-24" loading="lazy" decoding="async" />
    </a>
    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <a data-link class="font-bold hover:text-caramel-deep"><span data-name></span></a>
          <p class="text-sm text-muted" data-options></p>
        </div>
        <button
          type="button"
          class="-mt-1 -mr-1 grid size-9 shrink-0 place-items-center rounded-full text-muted transition-colors hover:bg-danger/10 hover:text-danger"
          data-remove
        >
          <Icon name="trash-2" size={18} />
        </button>
      </div>
      <div class="mt-auto flex items-center justify-between gap-2 pt-2">
        <div class="flex h-10 items-center rounded-full bg-sand px-1" role="group" data-qty-group>
          <button type="button" class="grid size-8 place-items-center rounded-full bg-card shadow-sm transition-transform active:scale-90" data-dec>
            <Icon name="minus" size={16} />
          </button>
          <span class="min-w-7 text-center font-bold tabular-nums" data-qty></span>
          <button type="button" class="grid size-8 place-items-center rounded-full bg-ink text-cream shadow-sm transition-transform active:scale-90 disabled:opacity-40" data-inc>
            <Icon name="plus" size={16} />
          </button>
        </div>
        <span class="font-extrabold tabular-nums" data-sum></span>
      </div>
    </div>
  </li>
</template>
