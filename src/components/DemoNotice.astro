---
interface Props {
  class?: string;
  tone?: 'soft' | 'dark';
}

const { class: className, tone = 'soft' } = Astro.props;
---

<p
  class:list={[
    'demo-notice flex items-start gap-3 rounded-2xl px-4 py-3 text-sm leading-snug',
    tone === 'soft' ? 'bg-sage-soft text-ink' : 'bg-cream/10 text-cream',
    className,
  ]}
>
  <span
    class:list={[
      'mt-0.5 inline-flex h-5 shrink-0 items-center rounded-full px-2 text-[11px] font-bold tracking-wide uppercase',
      tone === 'soft' ? 'bg-sage-deep text-cream' : 'bg-cream text-ink',
    ]}>Демо</span
  >
  <span>Демо-проект: кофейня вымышленная, заказы не принимаются.</span>
</p>
