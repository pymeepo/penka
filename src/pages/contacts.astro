---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoNotice from '../components/DemoNotice.astro';
import Icon from '../components/Icon.astro';
import { CITY, CONTACT_EMAIL, fullAddress, locations } from '../data/locations';
import { telHref } from '../lib/format';
import { loadImage } from '../lib/images';
import { absoluteUrl } from '../lib/url';

const site = Astro.site;
const pageUrl = absoluteUrl('contacts', site);

// Messengers: share links only, so nothing points to a real account.
const telegramShare = (url: string, text: string): string =>
  `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`;
const whatsappShare = (text: string): string => `https://wa.me/?text=${encodeURIComponent(text)}`;
const routeUrl = (address: string): string => `https://yandex.ru/maps/?text=${encodeURIComponent(address)}`;

const photos = await Promise.all(locations.map((loc) => loadImage(loc.image)));

const cards = locations.map((loc, i) => {
  const address = fullAddress(loc);
  const url = `${pageUrl}#${loc.slug}`;
  const hours = loc.hours.map((h) => `${h.days} ${h.time}`).join(', ');
  return {
    ...loc,
    photo: photos[i],
    fullAddress: address,
    url,
    route: routeUrl(address),
    telegram: telegramShare(url, `${loc.name}: ${address}. ${hours}`),
    shareText: `${loc.name} — ${address}`,
  };
});

const btn = 'btn btn-sm justify-start gap-2 rounded-2xl px-3.5';
---

<BaseLayout
  title="Кофейни и контакты"
  description={`Адреса трёх кофеен «Пенка» в ${CITY === 'Казань' ? 'Казани' : CITY}: часы работы, телефон, маршрут и как с нами связаться.`}
>
  <div class="container-page pt-6 md:pt-10">
    <p class="eyebrow">Три точки в {CITY === 'Казань' ? 'Казани' : CITY}</p>
    <h1 class="mt-1.5 text-3xl md:text-4xl">Кофейни и контакты</h1>

    <DemoNotice class="mt-5 max-w-2xl" />

    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          cards.map((loc) => (
            <article id={loc.slug} class="card flex scroll-mt-24 flex-col overflow-hidden" aria-labelledby={`${loc.slug}-title`}>
              <Image
                src={loc.photo}
                alt={loc.imageAlt}
                widths={[400, 640, 900]}
                sizes="(min-width: 1280px) 380px, (min-width: 768px) 46vw, 100vw"
                class="aspect-[16/10] w-full object-cover"
                loading={loc.slug === cards[0]?.slug ? 'eager' : 'lazy'}
              />
              <div class="flex flex-1 flex-col p-5">
              <h2 id={`${loc.slug}-title`} class="text-xl">
                {loc.name}
              </h2>
              <p class="mt-1 text-sm text-muted">{loc.note}</p>

              <dl class="mt-4 grid gap-3">
                <div class="flex gap-2.5">
                  <dt class="mt-0.5 text-sage-deep">
                    <Icon name="map-pin" size={18} label="Адрес" />
                  </dt>
                  <dd>{loc.fullAddress}</dd>
                </div>
                <div class="flex gap-2.5">
                  <dt class="mt-0.5 text-sage-deep">
                    <Icon name="clock" size={18} label="Часы работы" />
                  </dt>
                  <dd>
                    {loc.hours.map((h) => (
                      <span class="block">
                        <span class="text-muted">{h.days}</span> {h.time}
                      </span>
                    ))}
                  </dd>
                </div>
              </dl>

              <div class="mt-5 grid grid-cols-2 gap-2">
                <a href={telHref(loc.phone)} class:list={[btn, 'btn-primary']}>
                  <Icon name="phone" size={18} />
                  Позвонить
                </a>
                <a href={loc.route} target="_blank" rel="noopener noreferrer" class:list={[btn, 'btn-accent']}>
                  <Icon name="navigation" size={18} />
                  Маршрут
                </a>
                <a href={loc.telegram} target="_blank" rel="noopener noreferrer" class:list={[btn, 'btn-ghost']}>
                  <Icon name="send" size={18} />
                  Написать
                </a>
                <button
                  type="button"
                  class:list={[btn, 'btn-ghost']}
                  data-share
                  data-share-title={loc.name}
                  data-share-text={loc.shareText}
                  data-share-url={loc.url}
                >
                  <Icon name="share-2" size={18} />
                  Поделиться
                </button>
              </div>
              <p class="mt-auto pt-3 text-sm text-muted">
                Телефон: <span class="font-semibold whitespace-nowrap text-ink">{loc.phone}</span> (демо-номер)
              </p>
              </div>
            </article>
          ))
        }

        <section class="card p-5 md:col-span-2 xl:col-span-3" aria-labelledby="write-title">
          <h2 id="write-title" class="text-xl">Написать нам</h2>
          <p class="mt-1 text-sm text-muted">Отзывы, корпоративные заказы и сотрудничество.</p>
          <div class="mt-4 grid gap-2 sm:grid-cols-3">
            <a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Вопрос в «Пенку»')}`} class:list={[btn, 'btn-ghost']}>
              <Icon name="mail" size={18} />
              Почта
            </a>
            <a href={telegramShare(pageUrl, 'Кофейни «Пенка» — адреса и контакты')} target="_blank" rel="noopener noreferrer" class:list={[btn, 'btn-ghost']}>
              <Icon name="send" size={18} />
              Telegram
            </a>
            <a href={whatsappShare(`Кофейни «Пенка» — адреса и контакты: ${pageUrl}`)} target="_blank" rel="noopener noreferrer" class:list={[btn, 'btn-ghost']}>
              <Icon name="phone" size={18} />
              WhatsApp
            </a>
          </div>
          <p class="mt-3 text-sm">
            <a href={`mailto:${CONTACT_EMAIL}`} class="link">{CONTACT_EMAIL}</a>
          </p>
          <p class="mt-2 text-xs text-muted">В мессенджерах открывается окно «поделиться»: у демо-кофейни нет настоящих аккаунтов.</p>
        </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { bindShareButtons } from '../lib/share';

  bindShareButtons();
</script>
